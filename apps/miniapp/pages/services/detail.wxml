<!-- 服务详情 -->
<view class="page">

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view wx:elif="{{service}}">

    <view class="service-detail-hero">
      <view class="service-detail-top">
        <text class="service-detail-system">{{serviceSystemText}}</text>
        <text class="service-detail-price">{{priceText}}</text>
      </view>
      <text class="service-detail-title">{{service.name}}</text>
      <view class="service-provider-row" catch:tap="viewProviderAgent">
        <view class="provider-avatar">{{providerInitial}}</view>
        <view class="provider-main">
          <text class="provider-name">{{service.provider_nickname || service.provider_cid}}</text>
          <text class="provider-meta">信任 {{service.trust_score || 0}} · 交付 {{service.delivery_count || 0}}次</text>
        </view>
        <text class="provider-action">看档案</text>
      </view>
      <view class="summary-pill-list">
        <text class="summary-pill" wx:for="{{summaryPills}}" wx:key="item">{{item}}</text>
      </view>
      <view class="location-card" wx:if="{{service.location}}">
        <text class="location-label">服务地点</text>
        <text class="location-text">{{service.location}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-header">
        <text class="card-title">服务边界</text>
      </view>
      <view class="desc-block" wx:if="{{descriptionSections.length > 0}}">
        <view class="service-desc-section" wx:for="{{descriptionSections}}" wx:key="label">
          <text class="desc-label">{{item.label}}</text>
          <text class="desc-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 预演评分卡 -->
    <view class="pre-score-card" wx:if="{{preEnact}}" style="border-left-color: {{preScoreColor}}">
      <view class="pre-score-header">
        <text class="pre-score-label">预演匹配度</text>
        <text class="pre-score-value" style="color: {{preScoreColor}}">{{preEnact.total_score}}<text class="pre-score-unit">/100</text></text>
      </view>
      <text class="pre-score-summary">{{preEnact.summary}}</text>
      <view class="pre-dimensions">
        <view class="dim-item">
          <text class="dim-label">系统共振</text>
          <text class="dim-score">{{dimensionScores.resonance}}</text>
        </view>
        <view class="dim-item">
          <text class="dim-label">阶段适配</text>
          <text class="dim-score">{{dimensionScores.stage_fit}}</text>
        </view>
        <view class="dim-item">
          <text class="dim-label">历史一致</text>
          <text class="dim-score">{{dimensionScores.history}}</text>
        </view>
        <view class="dim-item">
          <text class="dim-label">信任可信</text>
          <text class="dim-score">{{dimensionScores.trust}}</text>
        </view>
      </view>
      <view class="pre-risks" wx:if="{{preEnact.risks && preEnact.risks.length > 0}}">
        <text class="risk-title">请注意</text>
        <text class="risk-item" wx:for="{{preEnact.risks}}" wx:for-item="r" wx:key="r">⚠️ {{r}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-header">
        <text class="card-title">预约前确认</text>
      </view>
      <view class="booking-check-list">
        <view class="booking-check-item">
          <text class="action-dot"></text>
          <text class="action-text">先看“适合谁 / 不适合谁”，确认这个服务确实匹配你的问题。</text>
        </view>
        <view class="booking-check-item">
          <text class="action-dot"></text>
          <text class="action-text">如果你不确定，可以先查看服务方档案和交付记录。</text>
        </view>
        <view class="booking-check-item">
          <text class="action-dot"></text>
          <text class="action-text">预约备注里写清楚目标、背景和希望解决的问题，服务方更容易判断。</text>
        </view>
      </view>
    </view>

    <!-- 信任信息 -->
    <view class="card" catch:tap="onContact">
      <view class="card-header">
        <text class="card-title">信任信息</text>
        <text class="card-action" catch:tap="onContact">发起联结</text>
      </view>
      <view class="info-row">
        <text class="info-label">服务方信任分</text>
        <text class="info-value">{{service.trust_score || '暂无'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">累计交付</text>
        <text class="info-value">{{service.delivery_count || 0}}次</text>
      </view>
    </view>

    <view class="action-bar">
      <button class="btn-inline btn-muted action-secondary" catch:tap="applyProviderMatch">先匹配</button>
      <button class="btn-primary action-primary" catch:tap="onBook">预约此服务</button>
    </view>
  </view>
</view>
