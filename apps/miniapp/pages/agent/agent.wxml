<!-- 我的Agent -->
<view class="page">

  <!-- Tab切换 -->
  <view class="tabs">
    <view class="tab {{activeTab === 'profile' ? 'active' : ''}}" data-tab="profile" catch:tap="switchTab">档案</view>
    <view class="tab {{activeTab === 'skills' ? 'active' : ''}}" data-tab="skills" catch:tap="switchTab">技能</view>
    <view class="tab {{activeTab === 'trust' ? 'active' : ''}}" data-tab="trust" catch:tap="switchTab">信任</view>
    <view class="tab {{activeTab === 'match' ? 'active' : ''}}" data-tab="match" catch:tap="switchTab">匹配</view>
  </view>

  <view class="empty" wx:if="{{errorMessage}}">
    <text>{{errorMessage}}</text>
    <button class="btn-primary" catch:tap="retryLoad">重试</button>
  </view>

  <!-- ═══════════ 档案Tab ═══════════ -->
  <view wx:if="{{!errorMessage && activeTab === 'profile'}}">

    <view class="loading" wx:if="{{loading.agent}}">加载中...</view>

    <view class="card" wx:elif="{{agent}}">
      <view class="card-header">
        <text class="card-title">Agent信息</text>
        <text class="card-action" wx:if="{{!editingBasicProfile}}" catch:tap="startEditBasicProfile">编辑</text>
      </view>

      <view wx:if="{{!editingBasicProfile}}">
        <view class="agent-basic">
          <image class="agent-basic-avatar" wx:if="{{basicForm.avatar_url}}" src="{{basicForm.avatar_url}}" mode="aspectFill"></image>
          <view class="agent-basic-avatar avatar-fallback" wx:else>{{agent.nickname ? agent.nickname[0] : '?'}}</view>
          <view class="agent-basic-meta">
            <text class="agent-basic-name">{{agent.nickname}}</text>
            <text class="agent-basic-cid">{{agent.cid}}</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-label">能量状态</text>
          <text class="info-value">{{agent.energy_status || '待设置'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">省份城市</text>
          <text class="info-value">{{basicProfile.province || '待设置'}} {{basicProfile.city || ''}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">性别</text>
          <text class="info-value">{{basicProfile.gender || '待设置'}}</text>
        </view>
        <view class="profile-section">
          <text class="profile-label">自我介绍</text>
          <text class="profile-text" wx:if="{{basicProfile.bio}}">{{basicProfile.bio}}</text>
          <text class="profile-empty" wx:else>补充一段介绍，让别人更快理解你是谁、正在做什么。</text>
        </view>
      </view>

      <view wx:else>
        <view class="form-group">
          <text class="form-label">称呼</text>
          <input class="form-input" data-field="nickname" bindinput="onBasicInput" value="{{basicForm.nickname}}" placeholder="请输入你的称呼" />
        </view>
        <view class="form-group">
          <text class="form-label">头像URL</text>
          <input class="form-input" data-field="avatar_url" bindinput="onBasicInput" value="{{basicForm.avatar_url}}" placeholder="可填图片链接，暂不上传本地图片" />
          <text class="form-help">当前版本先支持图片链接，后续接入微信头像选择和对象存储。</text>
        </view>
        <view class="form-group">
          <text class="form-label">省份</text>
          <input class="form-input" data-field="province" bindinput="onBasicInput" value="{{basicForm.province}}" placeholder="例如：广东省" />
        </view>
        <view class="form-group">
          <text class="form-label">城市</text>
          <input class="form-input" data-field="city" bindinput="onBasicInput" value="{{basicForm.city}}" placeholder="例如：东莞市" />
        </view>
        <view class="form-group">
          <text class="form-label">性别</text>
          <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
            <view class="picker">{{basicForm.gender || '未设置'}}</view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label">自我介绍</text>
          <textarea class="form-textarea" maxlength="500" data-field="bio" bindinput="onBasicInput" value="{{basicForm.bio}}" placeholder="简单介绍你是谁、所在行业、正在做的事，以及别人为什么可以找你。" />
        </view>
        <view class="editor-actions">
          <button class="btn-cancel" catch:tap="cancelEditBasicProfile">取消</button>
          <button class="btn-save" catch:tap="saveBasicProfile">保存资料</button>
        </view>
      </view>
    </view>

    <view class="card service-manage-card" wx:if="{{agent}}">
      <view class="card-header">
        <text class="card-title">服务项目</text>
        <text class="card-action" catch:tap="goManageServices">管理</text>
      </view>
      <text class="card-desc">把你的能力整理成可预约服务，也可以在这里修改服务内容、定价和上下架状态。</text>
      <view class="agent-service-actions">
        <button class="btn-primary" catch:tap="goCreateService">发布服务</button>
        <button class="btn-inline btn-muted" catch:tap="goManageServices">修改已有服务</button>
      </view>
    </view>

    <!-- 核心价值档案 -->
    <view class="card" wx:if="{{agent}}">
      <view class="card-header">
        <text class="card-title">核心价值档案</text>
        <text class="card-action" wx:if="{{!editingValueProfile}}" catch:tap="startEditValueProfile">编辑</text>
      </view>

      <text class="card-desc">用 Agent 的方式描述你能为他人提供的价值、经验与当下需求。</text>

      <view wx:if="{{!editingValueProfile}}">
        <view class="profile-section">
          <text class="profile-label">核心价值</text>
          <text class="profile-text" wx:if="{{valueProfile.core_value}}">{{valueProfile.core_value}}</text>
          <text class="profile-empty" wx:else>一句话说明你最擅长为谁解决什么问题。</text>
        </view>

        <view class="profile-section">
          <text class="profile-label">服务能力</text>
          <text class="profile-text" wx:if="{{valueProfile.service_capabilities}}">{{valueProfile.service_capabilities}}</text>
          <text class="profile-empty" wx:else>列出你可交付的能力、服务或资源。</text>
        </view>

        <view class="profile-section">
          <text class="profile-label">项目经历</text>
          <text class="profile-text" wx:if="{{valueProfile.project_experience}}">{{valueProfile.project_experience}}</text>
          <text class="profile-empty" wx:else>记录能证明你能力的项目、案例或成果。</text>
        </view>

        <view class="profile-section">
          <text class="profile-label">愿景需求</text>
          <text class="profile-text" wx:if="{{valueProfile.vision_needs}}">{{valueProfile.vision_needs}}</text>
          <text class="profile-empty" wx:else>写下你正在寻找的合作、资源、客户或成长方向。</text>
        </view>
      </view>

      <view wx:else>
        <view class="form-group">
          <text class="form-label">核心价值</text>
          <textarea class="form-textarea" maxlength="500" data-field="core_value" bindinput="onValueInput" value="{{valueForm.core_value}}" placeholder="例：我帮助本地生活服务者把经验沉淀成可交易、可信任的服务产品。" />
        </view>
        <view class="form-group">
          <text class="form-label">服务能力</text>
          <textarea class="form-textarea" maxlength="800" data-field="service_capabilities" bindinput="onValueInput" value="{{valueForm.service_capabilities}}" placeholder="例：业务梳理、服务产品设计、AI工具搭建、私域转化、项目陪跑。" />
        </view>
        <view class="form-group">
          <text class="form-label">项目经历</text>
          <textarea class="form-textarea" maxlength="1000" data-field="project_experience" bindinput="onValueInput" value="{{valueForm.project_experience}}" placeholder="例：做过哪些项目、服务过哪些客户、形成过哪些成果。" />
        </view>
        <view class="form-group">
          <text class="form-label">愿景需求</text>
          <textarea class="form-textarea" maxlength="800" data-field="vision_needs" bindinput="onValueInput" value="{{valueForm.vision_needs}}" placeholder="例：正在寻找服务方、合作伙伴、种子用户、场地资源或资金支持。" />
        </view>
        <view class="editor-actions">
          <button class="btn-cancel" catch:tap="cancelEditValueProfile">取消</button>
          <button class="btn-save" catch:tap="saveValueProfile">保存档案</button>
        </view>
      </view>
    </view>

    <!-- 生命阶段标签（核心） -->
    <view class="card" wx:if="{{agent}}">
      <view class="card-header">
        <text class="card-title">生命阶段标签</text>
        <text class="card-action" wx:if="{{!editingTags}}" catch:tap="startEditTags">编辑</text>
      </view>

      <view class="tag-display" wx:if="{{!editingTags}}">
        <view class="tag" wx:for="{{lifeStageTagLabels}}" wx:key="item">{{item}}</view>
        <text class="tag-empty" wx:if="{{agent.life_stage_tags.length === 0}}">尚未设置——设置后Agent才能为你精准匹配</text>
      </view>

      <!-- 编辑模式 -->
      <view class="tag-editor" wx:elif="{{editingTags}}">
        <text class="editor-hint">选择你当前活跃的领域（最多3个）</text>
        <view class="tag-grid">
          <view class="tag-option {{item.selected ? 'selected' : ''}}"
                wx:for="{{systemOptions}}" wx:key="value"
                data-value="{{item.value}}"
                catch:tap="toggleTag">
            {{item.label}}
          </view>
        </view>
        <view class="editor-actions">
          <button class="btn-cancel" catch:tap="cancelEditTags">取消</button>
          <button class="btn-save" catch:tap="saveTags">保存</button>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══════════ 技能Tab ═══════════ -->
  <view wx:elif="{{!errorMessage && activeTab === 'skills'}}">

    <view class="loading" wx:if="{{loading.skills}}">加载中...</view>

    <view class="card" wx:elif="{{skills.length > 0}}">
      <view class="card-header">
        <text class="card-title">预装技能包</text>
      </view>
      <text class="card-desc">你的Agent出厂自带的技能，默认开启，帮助监测你的生命状态</text>

      <view class="skill-list">
        <view class="skill-item" wx:for="{{skills}}" wx:key="key">
          <view class="skill-header">
            <text class="skill-name">{{item.name}}</text>
            <switch checked="{{item.status === 'active'}}" data-key="{{item.key}}" data-status="{{item.status}}" bindchange="toggleSkill" />
          </view>
          <text class="skill-desc">{{item.description}}</text>
          <view class="skill-levels">
            <text class="level-tag" wx:for="{{item.levels}}" wx:for-item="l" wx:key="l">{{l}}</text>
          </view>
          <text class="skill-recommend" wx:if="{{item.recommended}}">推荐开启</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══════════ 信任Tab ═══════════ -->
  <view wx:elif="{{!errorMessage && activeTab === 'trust'}}">

    <view class="loading" wx:if="{{loading.trust}}">加载中...</view>

    <view class="card" wx:elif="{{trustInfo}}">
      <view class="card-header">
        <text class="card-title">信任评分</text>
      </view>

      <view class="trust-score-big">
        <text class="big-number">{{trustInfo.trust_score || 0}}</text>
        <text class="big-label">/ 5</text>
      </view>

      <view class="info-row">
        <text class="info-label">累计交易</text>
        <text class="info-value">{{trustInfo.total_transactions || 0}}次</text>
      </view>
      <view class="info-row">
        <text class="info-label">服务交付</text>
        <text class="info-value">{{trustInfo.completed_deliveries || 0}}次</text>
      </view>
      <view class="info-row">
        <text class="info-label">平均评分</text>
        <text class="info-value">{{trustInfo.avg_rating || 0}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-header">
        <text class="card-title">信任网络</text>
        <text class="card-action">{{trustNetwork.connections.length || 0}}人</text>
      </view>
      <text class="card-desc">查看你主动连接、对方连接和交易过的 Agent。</text>

      <view class="loading" wx:if="{{loading.network}}">加载中...</view>

      <view wx:else>
        <view class="connection-section">
          <view class="connection-section-title">
            <text>我连接的人</text>
            <text>{{trustNetwork.outgoing.length || 0}}</text>
          </view>
          <view class="connection-item" wx:for="{{trustNetwork.outgoing}}" wx:key="cid">
            <view class="connection-main">
              <image class="agent-basic-avatar" wx:if="{{item.avatar_url}}" src="{{item.avatar_url}}" mode="aspectFill"></image>
              <view class="agent-basic-avatar avatar-fallback" wx:else>{{item.nickname ? item.nickname[0] : '?'}}</view>
              <view class="connection-info">
                <view class="connection-top">
                  <text class="connection-name">{{item.nickname}}</text>
                  <text class="trust-badge-small">{{item.trust_score || 0}}</text>
                </view>
                <text class="connection-cid">{{item.cid}}</text>
                <view class="service-tags" wx:if="{{item.life_stage_tags.length > 0}}">
                  <text class="service-tag" wx:for="{{item.life_stage_tag_labels}}" wx:for-item="tag" wx:key="tag">{{tag}}</text>
                </view>
              </view>
            </view>
            <view class="connection-actions">
              <button class="btn-inline btn-muted" data-cid="{{item.cid}}" catch:tap="viewConnectionAgent">看档案</button>
              <button class="btn-inline" data-cid="{{item.cid}}" catch:tap="matchConnectionAgent">匹配</button>
            </view>
          </view>
          <view class="connection-empty" wx:if="{{trustNetwork.outgoing.length === 0}}">还没有主动连接的 Agent。</view>
        </view>

        <view class="connection-section">
          <view class="connection-section-title">
            <text>连接我的人</text>
            <text>{{trustNetwork.incoming.length || 0}}</text>
          </view>
          <view class="connection-item" wx:for="{{trustNetwork.incoming}}" wx:key="cid">
            <view class="connection-main">
              <image class="agent-basic-avatar" wx:if="{{item.avatar_url}}" src="{{item.avatar_url}}" mode="aspectFill"></image>
              <view class="agent-basic-avatar avatar-fallback" wx:else>{{item.nickname ? item.nickname[0] : '?'}}</view>
              <view class="connection-info">
                <view class="connection-top">
                  <text class="connection-name">{{item.nickname}}</text>
                  <text class="trust-badge-small">{{item.trust_score || 0}}</text>
                </view>
                <text class="connection-cid">{{item.cid}}</text>
                <view class="service-tags" wx:if="{{item.life_stage_tags.length > 0}}">
                  <text class="service-tag" wx:for="{{item.life_stage_tag_labels}}" wx:for-item="tag" wx:key="tag">{{tag}}</text>
                </view>
              </view>
            </view>
            <view class="connection-actions">
              <button class="btn-inline btn-muted" data-cid="{{item.cid}}" catch:tap="viewConnectionAgent">看档案</button>
              <button class="btn-inline" data-cid="{{item.cid}}" catch:tap="matchConnectionAgent">匹配</button>
            </view>
          </view>
          <view class="connection-empty" wx:if="{{trustNetwork.incoming.length === 0}}">还没有人主动连接你。</view>
        </view>

        <view class="connection-section">
          <view class="connection-section-title">
            <text>交易过的人</text>
            <text>{{trustNetwork.traded.length || 0}}</text>
          </view>
          <view class="connection-item" wx:for="{{trustNetwork.traded}}" wx:key="cid">
            <view class="connection-main">
              <image class="agent-basic-avatar" wx:if="{{item.avatar_url}}" src="{{item.avatar_url}}" mode="aspectFill"></image>
              <view class="agent-basic-avatar avatar-fallback" wx:else>{{item.nickname ? item.nickname[0] : '?'}}</view>
              <view class="connection-info">
                <view class="connection-top">
                  <text class="connection-name">{{item.nickname}}</text>
                  <text class="trust-badge-small">{{item.trust_score || 0}}</text>
                </view>
                <text class="connection-cid">{{item.cid}}</text>
                <view class="service-tags" wx:if="{{item.life_stage_tags.length > 0}}">
                  <text class="service-tag" wx:for="{{item.life_stage_tag_labels}}" wx:for-item="tag" wx:key="tag">{{tag}}</text>
                </view>
              </view>
            </view>
            <view class="connection-actions">
              <button class="btn-inline btn-muted" data-cid="{{item.cid}}" catch:tap="viewConnectionAgent">看档案</button>
              <button class="btn-inline" data-cid="{{item.cid}}" catch:tap="matchConnectionAgent">匹配</button>
            </view>
          </view>
          <view class="connection-empty" wx:if="{{trustNetwork.traded.length === 0}}">还没有已完成交易的 Agent。</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{!errorMessage && activeTab === 'match'}}">
    <view class="card">
      <view class="card-header">
        <text class="card-title">Agent匹配分析</text>
      </view>
      <text class="card-desc">输入对方公开档案CID，生成一份价值、需求、信任和下一步行动报告。</text>
      <view class="form-group">
        <text class="form-label">对方CID</text>
        <input class="form-input" bindinput="onMatchCidInput" value="{{matchingTargetCid}}" placeholder="例如 UC-M-0002" />
      </view>
      <button class="btn-primary" catch:tap="generateMatchReport">生成匹配报告</button>
      <button class="btn-inline btn-muted" catch:tap="goAgentPlaza">去Agent广场</button>
    </view>

    <view class="card">
      <view class="card-header">
        <text class="card-title">使用建议</text>
      </view>
      <view class="action-item">
        <text class="action-dot"></text>
        <text class="action-text">先让双方补全核心价值、服务能力、项目经历和愿景需求。</text>
      </view>
      <view class="action-item">
        <text class="action-dot"></text>
        <text class="action-text">对一个人感兴趣时，从公开档案或服务详情页发起匹配。</text>
      </view>
      <view class="action-item">
        <text class="action-dot"></text>
        <text class="action-text">报告只作为行动建议，首次合作建议小范围验证。</text>
      </view>
    </view>

    <view class="card">
      <view class="card-header">
        <text class="card-title">历史匹配报告</text>
      </view>

      <view class="loading" wx:if="{{loading.matches}}">加载中...</view>

      <view wx:elif="{{matchReports.length > 0}}">
        <view class="match-history-item" wx:for="{{matchReports}}" wx:key="id" data-id="{{item.id}}" catch:tap="openMatchReport">
          <view class="match-history-top">
            <text class="match-history-title">{{item.title}}</text>
            <text class="match-score">{{item.total_score}}</text>
          </view>
          <text class="match-summary">{{item.summary}}</text>
          <text class="match-date">{{item.created_text}}</text>
        </view>
      </view>

      <view class="empty" wx:else>
        <text>还没有历史匹配报告。</text>
      </view>
    </view>
  </view>

</view>
