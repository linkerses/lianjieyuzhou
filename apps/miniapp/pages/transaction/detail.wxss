/* pages/transaction/detail.wxss */

.tx-detail-hero {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #2D3E2F;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tx-detail-hero.status-pending {
  border-left-color: #8A6A2F;
}

.tx-detail-hero.status-confirmed {
  border-left-color: #2D3E2F;
}

.tx-detail-hero.status-completed,
.tx-detail-hero.status-rated {
  border-left-color: #4A7C59;
}

.tx-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tx-role {
  color: #8A6A2F;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
}

.tx-status-pill {
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.tx-detail-title {
  display: block;
  color: #2D3E2F;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
  margin-bottom: 12rpx;
}

.tx-detail-hint {
  display: block;
  color: #6B7D6E;
  font-size: 26rpx;
  line-height: 1.65;
}

.tx-summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 22rpx;
}

.tx-summary-item {
  min-height: 96rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.tx-summary-label {
  display: block;
  color: #A8B5A9;
  font-size: 22rpx;
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.tx-summary-value {
  display: block;
  color: #2D3E2F;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.score-form {
  width: 100%;
  margin: 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.score-form-title {
  display: block;
  color: #2D3E2F;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.action-bar .btn-primary {
  margin: 0;
}
