<!-- 交易详情 -->
<view class="page">

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view wx:elif="{{transaction}}">

    <!-- 状态横幅 -->
    <view class="status-banner status-{{transaction.status}}">
      <text>{{statusLabel}}</text>
    </view>

    <!-- 交易信息 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">交易信息</text>
      </view>
      <view class="info-row">
        <text class="info-label">服务</text>
        <text class="info-value">{{serviceName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">金额</text>
        <text class="info-value price">{{transaction.amount}}元</text>
      </view>
      <view class="info-row" wx:if="{{transaction.scheduled_at}}">
        <text class="info-label">预约时间</text>
        <text class="info-value">{{transaction.scheduled_at}}</text>
      </view>
      <view class="info-row" wx:if="{{transaction.booking_note}}">
        <text class="info-label">预约备注</text>
        <text class="info-value">{{transaction.booking_note}}</text>
      </view>
      <view class="info-row" wx:if="{{transaction.completed_at}}">
        <text class="info-label">完成时间</text>
        <text class="info-value">{{transaction.completed_at}}</text>
      </view>
      <view class="info-row" wx:if="{{transaction.pre_score}}">
        <text class="info-label">预演评分</text>
        <text class="info-value">{{transaction.pre_score}}/100</text>
      </view>
      <view class="info-row" wx:if="{{transaction.actual_score}}">
        <text class="info-label">实际评分</text>
        <text class="info-value">{{transaction.actual_score}}/5</text>
      </view>
    </view>

    <!-- 服务方/买方信息 -->
    <view class="card">
      <view class="info-row">
        <text class="info-label">{{counterpartyLabel}}</text>
        <text class="info-value">{{counterpartyCid}}</text>
      </view>
    </view>

    <!-- 反馈内容 -->
    <view class="card" wx:if="{{transaction.buyer_note}}">
      <view class="card-header">
        <text class="card-title">买方反馈</text>
      </view>
      <text class="feedback-text">{{transaction.buyer_note}}</text>
    </view>

    <!-- 操作按钮组 -->
    <view class="action-bar">

      <!-- 服务方：确认开始 -->
      <button class="btn-primary" wx:if="{{isSeller && transaction.status === 'pending'}}" catch:tap="confirmService">
        确认开始服务
      </button>

      <!-- 买方：确认完成 -->
      <button class="btn-primary" wx:if="{{isBuyer && transaction.status === 'confirmed'}}" catch:tap="completeService">
        确认服务完成
      </button>

      <!-- 买方：评分入口 -->
      <view wx:if="{{isBuyer && transaction.status === 'completed' && !scoring}}">
        <button class="btn-primary" catch:tap="startScoring">提交评分</button>
      </view>

      <!-- 评分表单 -->
      <view class="score-form" wx:if="{{scoring}}">
        <view class="form-group">
          <text class="form-label">评分</text>
          <slider min="0" max="5" step="0.5" value="{{rating}}" show-value bindchange="onRatingChange" />
        </view>
        <view class="form-group">
          <text class="form-label">文字反馈</text>
          <input class="form-input" placeholder="分享你的体验..." bindinput="onNoteInput" />
        </view>
        <button class="btn-primary" catch:tap="submitFeedback">提交评分</button>
      </view>

    </view>
  </view>
</view>
