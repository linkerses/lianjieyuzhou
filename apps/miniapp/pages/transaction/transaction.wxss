/* pages/transaction/transaction.wxss */

.tx-list-hero {
  padding-bottom: 22rpx;
}

.tx-list .tx-card {
  border-left: 5rpx solid #EAEAE5;
}

.tx-list .tx-card-urgent {
  border-left-color: #B8860B;
}

.tx-list .tx-card-active {
  border-left-color: #2D3E2F;
}

.tx-list .tx-card-done {
  border-left-color: #4A7C59;
}

.tx-role-block {
  flex: 1;
  min-width: 0;
}

.tx-role-label {
  display: block;
  color: #8A6A2F;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.tx-list .tx-service {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #2D3E2F;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tx-list .tx-meta {
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
  margin-top: 14rpx;
}

.tx-list .tx-meta text {
  font-size: 23rpx;
  color: #A8B5A9;
  line-height: 1.4;
}

.tx-list .tx-amount {
  color: #B8860B !important;
  font-weight: 800;
}

.tx-counterparty {
  margin-top: 12rpx;
  color: #6B7D6E;
  font-size: 24rpx;
  line-height: 1.45;
}

.tx-action-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #F7F2E8;
  color: #6B5734;
  font-size: 24rpx;
  line-height: 1.5;
}

.tx-action-hint text:first-child {
  flex: 1;
  min-width: 0;
}

.tx-action-more {
  flex-shrink: 0;
  color: #8A6A2F;
  font-weight: 700;
}

.tx-card-done .tx-action-hint {
  background: #F3F7F1;
  color: #4A7C59;
}

.tx-card-done .tx-action-more {
  color: #4A7C59;
}
