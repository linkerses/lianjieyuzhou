<!-- 发布 / 编辑服务 -->
<view class="page">
  <view class="seller-hero">
    <text class="seller-title">{{isEdit ? '编辑服务' : '发布服务'}}</text>
    <text class="seller-subtitle">把你的能力包装成可被预约、可被信任、可被交付的服务。</text>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view wx:else>
    <view class="card">
      <view class="form-group">
        <text class="form-label">服务名称</text>
        <input class="form-input" data-field="name" bindinput="onInput" value="{{form.name}}" placeholder="例：空间造场咨询（1v1）" />
      </view>

      <view class="form-group">
        <text class="form-label">主系统</text>
        <picker mode="selector" range="{{systemOptions}}" range-key="label" bindchange="onPrimarySystemChange">
          <view class="picker">{{primarySystemLabel}}</view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">副系统</text>
        <picker mode="selector" range="{{secondarySystemOptions}}" range-key="label" bindchange="onSecondarySystemChange">
          <view class="picker">{{secondarySystemLabel}}</view>
        </picker>
        <text class="form-help">默认可不设置；需要复合能力时再选择。</text>
      </view>

      <view class="form-group">
        <text class="form-label">适合阶段</text>
        <input class="form-input" data-field="suitable_stages_text" bindinput="onInput" value="{{form.suitable_stages_text}}" placeholder="例：输出期、调整期、创业早期" />
      </view>

      <view class="form-group">
        <text class="form-label">服务介绍</text>
        <textarea class="form-textarea form-textarea-large" maxlength="2000" data-field="description" bindinput="onInput" value="{{form.description}}" placeholder="说明你解决什么问题、如何交付、适合谁、不适合谁。" />
      </view>
    </view>

    <view class="card">
      <view class="form-group">
        <text class="form-label">价格（元）</text>
        <input class="form-input" type="digit" data-field="price" bindinput="onInput" value="{{form.price}}" placeholder="例：398" />
      </view>

      <view class="form-group">
        <text class="form-label">服务时长（分钟）</text>
        <input class="form-input" type="number" data-field="duration_minutes" bindinput="onInput" value="{{form.duration_minutes}}" placeholder="例：75" />
      </view>

      <view class="form-group">
        <text class="form-label">交付方式</text>
        <picker mode="selector" range="{{deliveryOptions}}" range-key="label" bindchange="onDeliveryChange">
          <view class="picker">{{deliveryMethodLabel}}</view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">地点 / 交付说明</text>
        <input class="form-input" data-field="location" bindinput="onInput" value="{{form.location}}" placeholder="例：线上腾讯会议 / 东莞万江店" />
      </view>
    </view>

    <view class="action-bar">
      <button class="btn-primary" disabled="{{submitting}}" catch:tap="submitService">
        {{submitting ? '保存中...' : isEdit ? '保存修改' : '上架服务'}}
      </button>
    </view>
  </view>
</view>
