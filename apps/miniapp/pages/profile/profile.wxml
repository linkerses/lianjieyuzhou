<!-- 我的 -->
<view class="page">

  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar">{{agentAvatar}}</view>
    <view class="user-info">
      <text class="user-name">{{agentName}}</text>
      <text class="user-cid">{{agentCid}}</text>
      <view class="user-tags" wx:if="{{hasAgentTags}}">
        <text class="tag" wx:for="{{agentTags}}" wx:key="item">{{item}}</text>
      </view>
      <text class="user-hint" wx:else catch:tap="goEditTags">点击完善生命阶段 →</text>
    </view>
  </view>

  <view class="agent-hub-card">
    <view class="agent-hub-head">
      <view>
        <text class="agent-hub-eyebrow">数字档案工作台</text>
        <text class="agent-hub-title">我的Agent</text>
      </view>
      <text class="agent-hub-action" catch:tap="goAgent">进入</text>
    </view>
    <text class="agent-hub-desc">管理你的公开身份、当前需求、可预约服务和匹配关系。</text>
    <view class="agent-hub-grid">
      <view class="agent-hub-item {{item.state}}" wx:for="{{agentHubItems}}" wx:key="tab" data-tab="{{item.tab}}" catch:tap="goAgentTab">
        <view class="agent-hub-item-top">
          <text class="agent-hub-item-title">{{item.title}}</text>
          <text class="agent-hub-item-metric">{{item.metric}}</text>
        </view>
        <text class="agent-hub-item-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="quick-card" wx:if="{{quickActions.length > 0}}">
    <view class="quick-head">
      <text class="quick-title">下一步建议</text>
      <text class="quick-subtitle">选择一个动作继续推进</text>
    </view>
    <view class="quick-grid">
      <view class="quick-item" wx:for="{{quickActions}}" wx:key="key" data-key="{{item.key}}" catch:tap="onQuickAction">
        <text class="quick-item-title">{{item.title}}</text>
        <text class="quick-item-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="todo-card">
    <view class="card-header">
      <text class="card-title">协作中心</text>
      <text class="card-action" catch:tap="goCollaborationCenter">全部</text>
    </view>

    <view class="connection-inbox {{hasConnectionTodos ? 'active' : 'empty'}}">
      <view class="connection-inbox-head">
        <view>
          <text class="connection-inbox-eyebrow">联结消息</text>
          <text class="connection-inbox-title">{{hasConnectionTodos ? connectionTodoItems.length + ' 条待回复' : '暂无待回复'}}</text>
        </view>
        <text class="connection-inbox-badge" wx:if="{{hasConnectionTodos}}">新</text>
      </view>
      <view class="connection-inbox-item" wx:if="{{!hasConnectionTodos}}" catch:tap="goTrustNetwork">
        <text class="connection-inbox-empty-text">别人发起联结、回应需求后，会集中显示在这里。</text>
        <button class="connection-inbox-button secondary" catch:tap="goTrustNetwork">查看联结记录</button>
      </view>
      <view class="connection-inbox-item" wx:for="{{connectionTodoItems}}" wx:key="id" data-id="{{item.id}}" catch:tap="openConnectionThread">
        <view class="todo-title-row">
          <text class="todo-title">{{item.title}}</text>
          <text class="todo-tag">{{item.tag}}</text>
        </view>
        <text class="todo-desc">{{item.desc}}</text>
        <button class="connection-inbox-button" data-id="{{item.id}}" catch:tap="openConnectionThread">查看并回复</button>
      </view>
    </view>

    <view class="todo-item" wx:for="{{otherTodoItems}}" wx:key="id" data-id="{{item.id}}" data-type="{{item.type}}" catch:tap="openTodo">
      <view class="todo-main">
        <view class="todo-title-row">
          <text class="todo-title">{{item.title}}</text>
          <text class="todo-tag">{{item.tag}}</text>
        </view>
        <text class="todo-desc">{{item.desc}}</text>
      </view>
    </view>
    <view class="todo-empty" wx:if="{{!hasTodos}}">
      <text class="todo-empty-title">暂无待处理事项</text>
      <text class="todo-empty-desc">有新联结申请、预约、待确认交付或待评价时，会显示在这里。</text>
      <view class="todo-empty-actions">
        <button class="btn-inline btn-muted" catch:tap="goTransactions">交易记录</button>
        <button class="btn-inline" catch:tap="goTrustNetwork">联结申请</button>
      </view>
    </view>
  </view>

  <!-- 信任概要 -->
  <view class="trust-summary" wx:if="{{trustInfo}}" catch:tap="goTrustNetwork">
    <text class="trust-label">信任评分</text>
    <text class="trust-value">{{trustInfo.trust_score || 0}}</text>
    <text class="trust-detail">{{trustInfo.total_transactions || 0}}笔交易</text>
  </view>

  <!-- 功能入口 -->
  <view class="menu-group">
    <view class="menu-item" catch:tap="goTransactions">
      <text class="menu-icon">📋</text>
      <text class="menu-label">交易记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" catch:tap="goSellerWorkbench">
      <text class="menu-icon">🧾</text>
      <text class="menu-label">服务方工作台</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" catch:tap="goTrustNetwork">
      <text class="menu-icon">🔗</text>
      <text class="menu-label">信任网络</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" catch:tap="onShowAbout">
      <text class="menu-icon">📖</text>
      <text class="menu-label">关于联结宇宙</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 关于联结宇宙 弹窗 -->
  <view class="modal-mask" wx:if="{{showAbout}}" catch:tap="onHideAbout">
    <view class="modal-box" catch:tap="noop">
      <scroll-view class="modal-scroll" scroll-y>
        <view class="about-section">
          <text class="about-heading">关于联结宇宙</text>
          <text class="about-body">联结宇宙是一个 AI 驱动的个人价值连接平台。每个人都有自己的才能、经验和正在做的事。联结宇宙做的事情很简单——让 AI 帮你理解自己、找到对的人、把价值连接推进到真实协作。</text>
        </view>

        <view class="about-section">
          <text class="about-heading">从哪儿开始：四步走完一轮</text>
          <view class="about-step">
            <text class="about-step-num">①</text>
            <view>
              <text class="about-step-title">完善 Agent 档案</text>
              <text class="about-step-desc">创建你的数字分身——写下核心价值、服务能力、项目经历和当前需求。档案越完整，AI 的推荐与匹配越准确。</text>
            </view>
          </view>
          <view class="about-step">
            <text class="about-step-num">②</text>
            <view>
              <text class="about-step-title">浏览 Agent 广场</text>
              <text class="about-step-desc">去看看别人如何展示自己。你可能会发现：有人正在做你感兴趣的事，有人需要的恰好是你擅长的。</text>
            </view>
          </view>
          <view class="about-step">
            <text class="about-step-num">③</text>
            <view>
              <text class="about-step-title">生成匹配报告</text>
              <text class="about-step-desc">选中一个人，AI 会自动分析你们的契合点——合作方向、破冰建议、可能的协作方式。不用猜，报告告诉你。</text>
            </view>
          </view>
          <view class="about-step">
            <text class="about-step-num">④</text>
            <view>
              <text class="about-step-title">预约一个服务</text>
              <text class="about-step-desc">把你或对方的能力变成可预约的服务，完成一次真实协作。从联结走向交付，从交付积累信任。</text>
            </view>
          </view>
        </view>

        <view class="about-section">
          <text class="about-heading">什么时候用</text>
          <view class="about-table">
            <view class="about-row">
              <text class="about-row-scene">想找人合作但不知道找谁</text>
              <text class="about-row-do">→ 去 Agent 广场看公开档案，或让首页推荐帮你挑</text>
            </view>
            <view class="about-row">
              <text class="about-row-scene">想知道跟某个人合不合适</text>
              <text class="about-row-do">→ 生成一份匹配报告，AI 告诉你契合点和合作建议</text>
            </view>
            <view class="about-row">
              <text class="about-row-scene">有自己的能力想变现</text>
              <text class="about-row-do">→ 在服务方工作台发布服务，别人可以直接预约你</text>
            </view>
            <view class="about-row">
              <text class="about-row-scene">想找一项具体的服务</text>
              <text class="about-row-do">→ 在"找服务"里按系统分类浏览或搜索</text>
            </view>
            <view class="about-row">
              <text class="about-row-scene">完成了一次协作</text>
              <text class="about-row-do">→ 确认交付、给对方评分，信任分双向增长</text>
            </view>
            <view class="about-row">
              <text class="about-row-scene">一段时间没回来</text>
              <text class="about-row-do">→ 首页会显示待办事项和 Agent 的智能提醒</text>
            </view>
          </view>
        </view>

        <view class="about-section">
          <text class="about-heading">关键概念速查</text>
          <view class="about-glossary">
            <view class="about-term">
              <text class="about-term-word">Agent（数字分身）</text>
              <text class="about-term-def">你的线上档案，包含标签、价值、能力、经历和需求。别人在广场上看到的就是它。</text>
            </view>
            <view class="about-term">
              <text class="about-term-word">生命阶段标签</text>
              <text class="about-term-def">用 1-3 个标签说明当前的生命重心（如健康、财富、创造、探索），帮助 AI 理解你的优先级。</text>
            </view>
            <view class="about-term">
              <text class="about-term-word">匹配报告</text>
              <text class="about-term-def">AI 分析两个 Agent 档案后生成的合作评估，包含契合度分析和破冰建议。</text>
            </view>
            <view class="about-term">
              <text class="about-term-word">信任评分</text>
              <text class="about-term-def">每次成功交易和好评都会提升信任分。信任分越高，你的服务和连接越容易被推荐。</text>
            </view>
            <view class="about-term">
              <text class="about-term-word">找服务 vs 找人</text>
              <text class="about-term-def">找服务是直接预约可交付的项目；找人是先发现可联结的对象，再决定下一步。</text>
            </view>
          </view>
        </view>

        <view class="about-section about-footer">
          <text class="about-body">联结宇宙目前处于内测体验版，你的每一次使用、预约和反馈都在帮助我们打磨产品。</text>
          <text class="about-body">遇到问题？在「我的」页面提交反馈，我们每天都会看。</text>
        </view>
      </scroll-view>
      <view class="modal-close" catch:tap="onHideAbout">
        <text>我知道了</text>
      </view>
    </view>
  </view>

  <view class="feedback-card">
    <view class="feedback-head">
      <text class="feedback-title">内测反馈</text>
      <text class="feedback-desc">哪里卡住、看不懂、想要什么服务，都可以直接告诉我们。</text>
    </view>
    <picker mode="selector" range="{{feedbackTypes}}" range-key="label" value="{{feedbackTypeIndex}}" bindchange="onFeedbackTypeChange">
      <view class="feedback-picker">
        <text>{{selectedFeedbackTypeLabel}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </picker>
    <textarea class="feedback-textarea"
              value="{{feedbackContent}}"
              maxlength="1000"
              placeholder="请写下你遇到的问题、建议，或希望平台补充的服务。"
              bindinput="onFeedbackInput"></textarea>
    <input class="feedback-input"
           value="{{feedbackContact}}"
           placeholder="联系方式，可选"
           bindinput="onFeedbackContactInput" />
    <button class="btn-primary feedback-submit" loading="{{submittingFeedback}}" disabled="{{submittingFeedback}}" catch:tap="submitFeedback">提交反馈</button>
  </view>

  <!-- 开发信息 -->
  <view class="version" catch:tap="showDevInfo">
    <text>联结宇宙 V0.2</text>
  </view>
</view>
