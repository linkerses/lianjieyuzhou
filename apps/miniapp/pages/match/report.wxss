/* pages/match/report.wxss */

.match-action-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.match-action-btn {
  width: 100%;
  min-height: 76rpx;
  border: 0;
  border-radius: 12rpx;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 27rpx;
  font-weight: 600;
}

.match-action-btn.primary {
  background: #2D3E2F;
  color: #FFFFFF;
}

.match-action-cards {
  margin-top: 20rpx;
}

.match-action-card {
  background: #FAFAF8;
  border-radius: 12rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
}

.match-action-card-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2D3E2F;
  margin-bottom: 6rpx;
}

.match-action-card-desc {
  display: block;
  font-size: 24rpx;
  color: #6B7D6E;
  line-height: 1.5;
}
