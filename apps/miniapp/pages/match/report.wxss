/* pages/match/report.wxss */

.match-pair {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #A8B5A9;
  line-height: 1.45;
}

.match-type-badge {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  margin: 4rpx 0 10rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 23rpx;
  font-weight: 700;
}

.concrete-actions {
  margin-top: 14rpx;
}

.concrete-action {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #F0F0EC;
}

.concrete-index {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #2D3E2F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.concrete-text {
  flex: 1;
  min-width: 0;
  color: #2D3E2F;
  font-size: 26rpx;
  line-height: 1.55;
}

.next-step-panel .btn-primary {
  height: 68rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin-top: 4rpx;
}

.match-link-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 28rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0EC;
}

.match-link {
  color: #2D3E2F;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.match-link.muted {
  color: #A8B5A9;
}

.match-evidence {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
  margin-bottom: 14rpx;
}

.match-evidence.caution {
  background: #FFF8EA;
}

.match-evidence.action {
  background: #F4F7F1;
  border-left: 5rpx solid #2D3E2F;
}

.empty.compact {
  padding: 18rpx 0;
  text-align: left;
}

.evidence-label {
  display: block;
  font-size: 22rpx;
  color: #8A6A2F;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.evidence-text {
  display: block;
  font-size: 25rpx;
  color: #6B7D6E;
  line-height: 1.65;
  margin-top: 6rpx;
}
