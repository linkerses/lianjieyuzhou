/* pages/match/report.wxss */

.match-action-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.match-action-btn {
  width: 100%;
  min-height: 84rpx;
  border: 0;
  border-radius: 14rpx;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 28rpx;
  font-weight: 600;
}

.match-action-btn.primary {
  background: #2D3E2F;
  color: #FFFFFF;
}

.match-action-cards {
  margin-top: 24rpx;
}

.match-action-card {
  background: #FAFAF8;
  border-radius: 12rpx;
  padding: 22rpx;
  margin-bottom: 14rpx;
}

.match-action-card-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #2D3E2F;
  margin-bottom: 8rpx;
}

.match-action-card-desc {
  display: block;
  font-size: 25rpx;
  color: #6B7D6E;
  line-height: 1.65;
}
