<view class="page">
  <view class="loading" wx:if="{{loading}}">正在生成匹配报告...</view>

  <view wx:elif="{{report}}">
    <view class="pre-score-card" style="border-left-color: {{scoreColor}}">
      <view class="pre-score-header">
        <text class="pre-score-label">Agent匹配度</text>
        <text class="pre-score-value" style="color: {{scoreColor}}">{{report.total_score}}<text class="pre-score-unit">/100</text></text>
      </view>
      <text class="match-type-badge" wx:if="{{report.match_type && report.match_type.label}}">{{report.match_type.label}}</text>
      <text class="match-pair">{{report.source_agent.nickname}} × {{report.target_agent.nickname}}</text>
      <text class="pre-score-summary">{{report.summary}}</text>
    </view>

    <view class="card">
      <view class="card-header">
        <text class="card-title">下一步</text>
        <text class="card-action" catch:tap="viewTargetAgent">看档案</text>
      </view>
      <view class="next-step-panel">
        <text class="next-step-label">建议先做</text>
        <text class="next-step-title">{{primaryActionTitle}}</text>
        <text class="next-step-desc">{{actionHint}}</text>
        <button class="btn-primary" catch:tap="takePrimaryAction">{{primaryActionText}}</button>
      </view>
      <view class="concrete-actions">
        <view class="concrete-action" wx:for="{{concreteActions}}" wx:key="item">
          <text class="concrete-index">{{index + 1}}</text>
          <text class="concrete-text">{{item}}</text>
        </view>
      </view>
      <view class="match-link-row">
        <text class="match-link" wx:if="{{primaryService}}" catch:tap="connectTarget">先连接</text>
        <text class="match-link" wx:else catch:tap="viewTargetAgent">看对方档案</text>
        <text class="match-link" catch:tap="copyIntentMessage">复制破冰话术</text>
        <text class="match-link" wx:if="{{!followMarked}}" catch:tap="markFollowUp">标记跟进</text>
        <text class="match-link muted" wx:else>已跟进</text>
      </view>
    </view>

    <view class="card">
      <view class="card-header">
        <text class="card-title">合作切入点</text>
      </view>
      <view class="match-evidence action" wx:if="{{entrypoints.length > 0}}">
        <text class="evidence-text" wx:for="{{entrypoints}}" wx:key="item">{{item}}</text>
      </view>
      <view class="empty compact" wx:else>
        <text>暂无明确切入点，建议先补充双方需求和服务边界。</text>
      </view>
    </view>

    <view class="card">
      <view class="card-header">
        <text class="card-title">判断依据</text>
      </view>
      <view class="match-evidence" wx:if="{{keyFindings.length > 0}}">
        <text class="evidence-text" wx:for="{{keyFindings}}" wx:key="item">{{item}}</text>
      </view>
      <view class="match-evidence caution" wx:if="{{cautionItems.length > 0}}">
        <text class="evidence-label">风险提醒</text>
        <text class="evidence-text" wx:for="{{cautionItems}}" wx:key="item">{{item}}</text>
      </view>
      <view class="pre-dimensions">
        <view class="dim-item">
          <text class="dim-label">我的需求</text>
          <text class="dim-score">{{report.dimensions.demand_fit}}</text>
        </view>
        <view class="dim-item">
          <text class="dim-label">对方需求</text>
          <text class="dim-score">{{report.dimensions.reverse_demand_fit}}</text>
        </view>
        <view class="dim-item">
          <text class="dim-label">价值共振</text>
          <text class="dim-score">{{report.dimensions.value_fit}}</text>
        </view>
        <view class="dim-item">
          <text class="dim-label">系统标签</text>
          <text class="dim-score">{{report.dimensions.system_fit}}</text>
        </view>
        <view class="dim-item">
          <text class="dim-label">信任基础</text>
          <text class="dim-score">{{report.dimensions.trust_fit}}</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{targetServices.length > 0}}">
      <view class="card-header">
        <text class="card-title">对方可预约服务</text>
        <text class="card-action" catch:tap="viewTargetAgent">看档案</text>
      </view>
      <view class="match-service-item" wx:for="{{targetServices}}" wx:key="id">
        <view data-id="{{item.id}}" catch:tap="viewService">
          <view class="service-top">
            <text class="service-system">{{item.primary_system}}</text>
            <text class="service-price">{{item.price}}元</text>
          </view>
          <text class="service-name">{{item.name}}</text>
          <view class="service-meta">
            <text wx:if="{{item.duration_minutes}}">{{item.duration_minutes}}分钟</text>
            <text>交付 {{item.delivery_count || 0}}</text>
          </view>
        </view>
        <button class="btn-inline" data-id="{{item.id}}" data-seller="{{item.provider_cid}}" catch:tap="bookService">预约</button>
      </view>
    </view>
  </view>
</view>
