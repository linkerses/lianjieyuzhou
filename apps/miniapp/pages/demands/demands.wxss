/* pages/demands/demands.wxss */

.demand-hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.demand-count {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.demand-hero-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #2D3E2F;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.4;
}

.demand-waterfall {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.demand-plaza-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.demand-card-labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.demand-card-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #8A6A2F;
  line-height: 1.4;
}

.demand-card-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #A8B5A9;
  line-height: 1.4;
}

.demand-plaza-card .demand-title {
  font-size: 31rpx;
  line-height: 1.42;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.demand-plaza-card .demand-desc {
  display: -webkit-box;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.demand-action-hint {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #F7F2E8;
  color: #6B5734;
  font-size: 24rpx;
  line-height: 1.55;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.demand-agent {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
}

.demand-agent-avatar {
  width: 64rpx;
  height: 64rpx;
  margin-right: 0;
  font-size: 26rpx;
}

.demand-agent-main {
  flex: 1;
  min-width: 0;
}

.demand-agent-label {
  display: block;
  margin-bottom: 4rpx;
  font-size: 21rpx;
  color: #A8B5A9;
  line-height: 1.35;
}

.demand-agent-name {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: #2D3E2F;
  line-height: 1.35;
}

.demand-agent-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A8B5A9;
  line-height: 1.4;
}

.demand-plaza-card .service-tags {
  max-height: 52rpx;
  overflow: hidden;
}

.demand-plaza-card .service-tag {
  max-width: 240rpx;
}

.demand-card-action {
  display: block;
  margin-top: 16rpx;
  color: #2D3E2F;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}
