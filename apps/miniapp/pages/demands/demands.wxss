/* pages/demands/demands.wxss */

.demand-hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.demand-count {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.demand-hero-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #2D3E2F;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.4;
}

.demand-plaza-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.demand-card-labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.demand-card-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #8A6A2F;
  line-height: 1.4;
}

.demand-card-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #A8B5A9;
  line-height: 1.4;
}

.demand-plaza-card .demand-title {
  font-size: 31rpx;
  line-height: 1.42;
}

.demand-plaza-card .demand-desc {
  display: -webkit-box;
  line-height: 1.65;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
}

.demand-action-hint {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #F7F2E8;
  color: #6B5734;
  font-size: 24rpx;
  line-height: 1.55;
}

.demand-agent {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
}

.demand-agent-avatar {
  width: 64rpx;
  height: 64rpx;
  margin-right: 0;
  font-size: 26rpx;
}

.demand-agent-main {
  flex: 1;
  min-width: 0;
}

.demand-agent-name {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: #2D3E2F;
  line-height: 1.35;
}

.demand-agent-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A8B5A9;
  line-height: 1.4;
}

.demand-plaza-card .demand-actions {
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.demand-plaza-card .demand-actions .btn-inline {
  height: 58rpx;
  min-height: 58rpx;
  font-size: 24rpx;
  border-radius: 29rpx;
}
