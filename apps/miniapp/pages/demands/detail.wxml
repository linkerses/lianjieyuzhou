<view class="page demand-detail-page">
  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view wx:elif="{{demand && agent}}">
    <view class="demand-detail-hero">
      <view class="demand-detail-meta">
        <text class="demand-card-label">正在寻找</text>
        <text class="demand-card-time">{{demand.time_label}}</text>
      </view>
      <text class="demand-detail-title">{{demand.title}}</text>
      <text class="demand-detail-desc">{{demand.description}}</text>
    </view>

    <view class="card demand-publisher-card">
      <view class="card-header">
        <text class="card-title">发布者</text>
        <text class="card-action" catch:tap="viewAgent">看档案</text>
      </view>
      <view class="publisher-panel" catch:tap="viewAgent">
        <view class="agent-basic-avatar demand-detail-avatar">{{agent.initial}}</view>
        <view class="publisher-main">
          <view class="publisher-head">
            <text class="demand-detail-agent-name">{{agent.nickname || agent.cid}}</text>
            <text class="publisher-score">信任 {{agent.trust_score || 0}}</text>
          </view>
          <text class="demand-detail-agent-meta">{{locationText}}</text>
          <view class="tag-display detail-tags" wx:if="{{tagLabels.length > 0}}">
            <text class="tag" wx:for="{{tagLabels}}" wx:key="item">{{item}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="demand-detail-bottom" wx:if="{{demand && agent}}">
    <button class="btn-primary" catch:tap="respondDemand">回应需求</button>
  </view>

  <view class="response-mask" wx:if="{{showResponsePanel}}" catch:tap="closeResponsePanel">
    <view class="response-panel" catch:tap="noop">
      <view class="response-head">
        <text class="response-title">回应需求</text>
        <text class="response-close" catch:tap="closeResponsePanel">关闭</text>
      </view>
      <textarea class="response-textarea"
                value="{{responseMessage}}"
                maxlength="500"
                auto-height="{{false}}"
                fixed="{{true}}"
                placeholder="写清楚你能提供什么帮助、资源或下一步建议"
                bindinput="onResponseInput"></textarea>
      <view class="response-actions">
        <button class="btn-inline btn-muted" catch:tap="closeResponsePanel">取消</button>
        <button class="btn-primary" loading="{{submittingResponse}}" disabled="{{submittingResponse}}" catch:tap="submitResponse">发送</button>
      </view>
    </view>
  </view>
</view>
