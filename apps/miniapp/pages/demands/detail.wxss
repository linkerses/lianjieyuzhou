.demand-detail-page {
  padding-bottom: 128rpx;
}

.demand-detail-hero {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #8A6A2F;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.demand-detail-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.demand-card-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #8A6A2F;
  line-height: 1.4;
}

.demand-card-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #A8B5A9;
  line-height: 1.4;
}

.demand-detail-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #2D3E2F;
  line-height: 1.38;
}

.demand-detail-desc {
  display: block;
  margin-top: 22rpx;
  color: #2D3E2F;
  font-size: 30rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.demand-publisher-card {
  background: #FFFFFF;
  box-shadow: none;
  border: 1rpx solid #EEEAE1;
}

.publisher-panel {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 6rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #FAFAF8;
}

.demand-detail-avatar {
  width: 76rpx;
  height: 76rpx;
  margin-right: 0;
  font-size: 30rpx;
}

.publisher-main {
  flex: 1;
  min-width: 0;
}

.publisher-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.demand-detail-agent-name {
  display: block;
  flex: 1;
  min-width: 0;
  color: #2D3E2F;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.publisher-score {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.demand-detail-agent-meta {
  display: block;
  margin-top: 6rpx;
  color: #6B7D6E;
  font-size: 24rpx;
  line-height: 1.45;
}

.detail-tags {
  margin-top: 14rpx;
}

.detail-tags .tag {
  background: #FFFFFF;
}

.demand-detail-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(250, 250, 248, 0.96);
  border-top: 1rpx solid #EAEAE5;
  z-index: 20;
}

.demand-detail-bottom .btn-primary {
  width: 100%;
  margin: 0;
}

.response-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0,0,0,0.42);
  display: flex;
  align-items: flex-end;
}

.response-panel {
  width: 100%;
  padding: 30rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #FAFAF8;
  box-sizing: border-box;
}

.response-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.response-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2D3E2F;
  line-height: 1.4;
}

.response-close {
  flex-shrink: 0;
  color: #8D9A8E;
  font-size: 25rpx;
  line-height: 1.4;
}

.response-textarea {
  width: 100%;
  height: 240rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #2D3E2F;
  font-size: 28rpx;
  line-height: 1.65;
  box-sizing: border-box;
}

.response-actions {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.response-actions .btn-inline,
.response-actions .btn-primary {
  width: 100%;
  margin: 0;
}
