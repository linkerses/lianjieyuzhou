<view class="page public-agent-page">
  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view wx:elif="{{agent}}">
    <view class="public-agent-hero">
      <view class="agent-basic">
        <image class="agent-basic-avatar" wx:if="{{agent.avatar_url}}" src="{{agent.avatar_url}}" mode="aspectFill"></image>
        <view class="agent-basic-avatar avatar-fallback" wx:else>{{agent.initial}}</view>
        <view class="agent-basic-meta">
          <text class="agent-basic-name">{{agent.nickname || '联结者'}}</text>
          <text class="agent-basic-cid">{{locationText}} · {{agent.basic_profile.gender || '性别未填写'}}</text>
        </view>
      </view>
      <text class="public-agent-summary">{{profileSummary}}</text>
      <view class="public-agent-metrics">
        <view class="public-agent-metric">
          <text class="public-agent-metric-value">{{agent.trust_score || 0}}</text>
          <text class="public-agent-metric-label">信任分</text>
        </view>
        <view class="public-agent-metric">
          <text class="public-agent-metric-value">{{agent.demand_posts.length || 0}}</text>
          <text class="public-agent-metric-label">公开需求</text>
        </view>
        <view class="public-agent-metric">
          <text class="public-agent-metric-value">{{agent.life_stage_tag_labels.length || 0}}</text>
          <text class="public-agent-metric-label">标签</text>
        </view>
      </view>
      <view class="tag-display">
        <text class="tag" wx:for="{{agent.life_stage_tag_labels}}" wx:key="item">{{item}}</text>
        <text class="tag-empty" wx:if="{{agent.life_stage_tags.length === 0}}">未设置标签</text>
      </view>
      <view class="public-agent-actions">
        <button class="btn-inline btn-muted" catch:tap="copyCid">复制CID</button>
        <button class="btn-inline btn-muted" catch:tap="applyMatch">匹配</button>
        <button class="btn-inline" catch:tap="startConnection">留言连接</button>
      </view>
    </view>

    <view class="public-section-nav">
      <view class="public-section-nav-item" data-target="profile-section" catch:tap="scrollToSection">
        <text class="public-section-nav-title">价值档案</text>
      </view>
      <view class="public-section-nav-item" data-target="demand-section" catch:tap="scrollToSection">
        <text class="public-section-nav-title">正在寻找</text>
        <text class="public-section-nav-count">{{agent.demand_posts.length || 0}}</text>
      </view>
      <view class="public-section-nav-item" data-target="service-section" catch:tap="scrollToSection">
        <text class="public-section-nav-title">可预约服务</text>
        <text class="public-section-nav-count">{{services.length || 0}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{agent.basic_profile.bio}}">
      <view class="card-header">
        <text class="card-title">个人简介</text>
      </view>
      <text class="profile-text">{{agent.basic_profile.bio}}</text>
    </view>

    <view class="card" id="profile-section">
      <view class="card-header">
        <text class="card-title">公开身份档案</text>
      </view>
      <view class="profile-section">
        <text class="profile-label">核心价值</text>
        <text class="profile-text" wx:if="{{agent.value_profile.core_value}}">{{agent.value_profile.core_value}}</text>
        <text class="profile-empty" wx:else>对方暂未填写。</text>
      </view>
      <view class="profile-section">
        <text class="profile-label">服务能力</text>
        <text class="profile-text" wx:if="{{agent.value_profile.service_capabilities}}">{{agent.value_profile.service_capabilities}}</text>
        <text class="profile-empty" wx:else>对方暂未填写。</text>
      </view>
      <view class="profile-section">
        <text class="profile-label">项目经历</text>
        <text class="profile-text" wx:if="{{agent.value_profile.project_experience}}">{{agent.value_profile.project_experience}}</text>
        <text class="profile-empty" wx:else>对方暂未填写。</text>
      </view>
    </view>

    <view class="card" id="demand-section">
      <view class="card-header">
        <text class="card-title">正在寻找</text>
      </view>
      <view class="public-demand-list" wx:if="{{agent.demand_posts.length > 0}}">
        <view class="public-demand-card" wx:for="{{agent.demand_posts}}" wx:key="id" data-source-id="{{item.id}}" catch:tap="openDemandDetail">
          <view class="public-demand-labels">
            <text class="public-demand-label">正在寻找</text>
            <text class="demand-status demand-open">进行中</text>
          </view>
          <view class="demand-top">
            <text class="demand-title">{{item.title}}</text>
          </view>
          <text class="demand-desc">{{item.description}}</text>
          <text class="public-demand-action">查看详情</text>
        </view>
      </view>
      <text class="profile-empty" wx:else>对方暂未发布公开需求。</text>
    </view>

    <view class="card" id="service-section">
      <view class="card-header">
        <text class="card-title">可预约服务</text>
      </view>
      <view class="public-service-list" wx:if="{{services.length > 0}}">
        <view class="public-service-card" wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" catch:tap="viewService">
          <view class="public-service-top">
            <text class="public-service-system">{{item.system_label}}</text>
            <text class="public-service-price">{{item.price_label}}</text>
          </view>
          <text class="public-service-name">{{item.name}}</text>
          <view class="service-tags" wx:if="{{item.tags.length > 0}}">
            <text class="service-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="tag">{{tag}}</text>
          </view>
          <text class="public-demand-action">查看服务</text>
        </view>
      </view>
      <text class="profile-empty" wx:else>对方暂未上架可预约服务。</text>
    </view>

    <view class="action-bar public-agent-bottom-actions">
      <button class="public-bottom-button muted" catch:tap="applyMatch">先看匹配</button>
      <button class="public-bottom-button primary" catch:tap="startConnection">发起连接</button>
    </view>
  </view>
</view>
