/* pages/agents/public.wxss */

.public-agent-hero {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #2D3E2F;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.public-agent-hero .agent-basic {
  margin-bottom: 18rpx;
}

.public-agent-summary {
  display: block;
  color: #2D3E2F;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.55;
  margin-bottom: 20rpx;
}

.public-agent-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.public-agent-metric {
  min-height: 96rpx;
  border-radius: 14rpx;
  background: #FAFAF8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 6rpx;
  box-sizing: border-box;
}

.public-agent-metric-value {
  display: block;
  color: #2D3E2F;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.2;
}

.public-agent-metric-label {
  display: block;
  margin-top: 6rpx;
  color: #A8B5A9;
  font-size: 21rpx;
  line-height: 1.35;
}

.public-agent-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.public-agent-actions .btn-inline {
  width: 100%;
  margin: 0;
  height: 62rpx;
  border-radius: 31rpx;
}

.public-agent-hero .tag-display {
  margin-top: 4rpx;
}

.public-agent-hero .agent-basic-name {
  font-size: 34rpx;
}

.public-agent-hero .agent-basic-cid {
  color: #6B7D6E;
}

.public-demand-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.public-demand-card {
  padding: 22rpx;
  border-radius: 14rpx;
  background: #FAFAF8;
  border-left: 5rpx solid #8A6A2F;
}

.public-demand-labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.public-demand-label {
  color: #8A6A2F;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.public-demand-card .demand-title {
  display: -webkit-box;
  font-size: 30rpx;
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.public-demand-card .demand-desc {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.public-demand-action {
  display: block;
  margin-top: 16rpx;
  color: #2D3E2F;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.public-agent-bottom-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.public-bottom-button {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  line-height: normal;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 20rpx;
  border: none;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.public-bottom-button.primary {
  background: #2D3E2F;
  color: #FFFFFF;
}

.public-bottom-button.muted {
  background: #E8EDE6;
  color: #2D3E2F;
}
