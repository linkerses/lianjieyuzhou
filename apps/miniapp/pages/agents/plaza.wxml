<view class="page">
  <view class="seller-hero">
    <text class="seller-title">Agent广场</text>
    <text class="seller-subtitle">发现公开身份档案，查看价值与需求，再发起匹配分析。</text>
  </view>

  <scroll-view class="filter-bar" scroll-x>
    <view class="filter-item {{activeFilter === item.key ? 'active' : ''}}"
          wx:for="{{filters}}"
          wx:key="key"
          data-key="{{item.key}}"
          catch:tap="switchFilter">
      {{item.label}}
    </view>
  </scroll-view>

  <scroll-view class="filter-bar sort-bar" scroll-x>
    <view class="filter-item {{activeSort === item.key ? 'active' : ''}}"
          wx:for="{{sorts}}"
          wx:key="key"
          data-key="{{item.key}}"
          catch:tap="switchSort">
      {{item.label}}
    </view>
  </scroll-view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view wx:elif="{{agents.length > 0}}">
    <view class="agent-plaza-card" wx:for="{{agents}}" wx:key="cid">
      <view class="agent-plaza-main" data-cid="{{item.cid}}" catch:tap="viewAgent">
        <image class="agent-plaza-avatar" wx:if="{{item.avatar_url}}" src="{{item.avatar_url}}" mode="aspectFill"></image>
        <view class="agent-plaza-avatar avatar-fallback" wx:else>{{item.initial}}</view>
        <view class="agent-plaza-info">
          <view class="agent-plaza-top">
            <text class="agent-plaza-name">{{item.nickname}}</text>
            <text class="trust-badge-small">信任 {{item.trust_score || 0}}</text>
          </view>
          <text class="agent-plaza-cid">{{item.cid}}</text>
          <view class="agent-plaza-metrics">
            <text>{{item.service_count || 0}}个服务</text>
            <text>档案{{item.profile_completion || 0}}%</text>
          </view>
          <view class="service-tags">
            <text class="service-tag" wx:for="{{item.life_stage_tags}}" wx:key="item">{{item}}</text>
          </view>
        </view>
      </view>

      <text class="profile-text">{{item.core_value}}</text>
      <text class="profile-empty">{{item.service_capabilities}}</text>

      <view class="service-actions">
        <button class="btn-inline btn-muted" data-cid="{{item.cid}}" catch:tap="viewAgent">看档案</button>
        <button class="btn-inline" data-cid="{{item.cid}}" catch:tap="applyMatch">匹配</button>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text>当前标签下暂无公开Agent。</text>
  </view>
</view>
