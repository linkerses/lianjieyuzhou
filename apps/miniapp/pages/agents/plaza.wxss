/* pages/agents/plaza.wxss */

.metric-pill {
  display: inline-block;
  background: #F5F5F0;
  color: #6B7D6E;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.metric-pill.strong {
  background: #E8EDE6;
  color: #2D3E2F;
  font-weight: 600;
}

.agent-value-list,
.agent-value-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

.agent-value-block {
  background: #FAFAF8;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
}

.agent-value-label {
  display: block;
  font-size: 22rpx;
  color: #8A6A2F;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.agent-value-text {
  display: block;
  color: #2D3E2F;
  font-size: 26rpx;
  line-height: 1.65;
}

.agent-reason {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 12rpx;
  background: #F7F2E8;
}

.agent-reason-label {
  display: block;
  color: #8A6A2F;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.agent-reason-text {
  display: block;
  color: #5D4B2C;
  font-size: 25rpx;
  line-height: 1.65;
}
