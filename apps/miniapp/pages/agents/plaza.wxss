/* pages/agents/plaza.wxss */

.metric-pill {
  display: inline-block;
  background: #F5F5F0;
  color: #6B7D6E;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.metric-pill.strong {
  background: #E8EDE6;
  color: #2D3E2F;
  font-weight: 600;
}

.agent-value-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.agent-value-block {
  background: #FAFAF8;
  border-radius: 12rpx;
  padding: 18rpx;
  min-height: 148rpx;
}

.agent-value-label {
  display: block;
  font-size: 22rpx;
  color: #8A6A2F;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.agent-value-text {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  color: #2D3E2F;
  font-size: 25rpx;
  line-height: 1.5;
}

.agent-reason {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #F7F2E8;
}

.agent-reason-label {
  display: block;
  color: #8A6A2F;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.agent-reason-text {
  display: block;
  color: #5D4B2C;
  font-size: 24rpx;
  line-height: 1.5;
}
