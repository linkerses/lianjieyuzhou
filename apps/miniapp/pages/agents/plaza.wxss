/* pages/agents/plaza.wxss */

.plaza-hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.plaza-count {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.agent-plaza-card {
  border-left: 5rpx solid #2D3E2F;
}

.plaza-card-labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.plaza-card-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #8A6A2F;
  line-height: 1.4;
}

.plaza-card-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #A8B5A9;
  line-height: 1.4;
}

.metric-pill {
  display: inline-block;
  background: #F5F5F0;
  color: #6B7D6E;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.metric-pill.strong {
  background: #E8EDE6;
  color: #2D3E2F;
  font-weight: 600;
}

.agent-value-list,
.agent-value-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
}

.agent-value-block {
  background: #FAFAF8;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
}

.agent-value-block.core {
  background: #F3F7F1;
}

.agent-value-label {
  display: block;
  font-size: 22rpx;
  color: #8A6A2F;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.agent-value-text {
  display: block;
  color: #2D3E2F;
  font-size: 26rpx;
  line-height: 1.65;
}

.line-clamp {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.agent-card-action {
  display: block;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0EC;
  color: #2D3E2F;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
}
