/* pages/booking/booking.wxss */

.booking-summary {
  text-align: left;
  border-left: 6rpx solid #2D3E2F;
}

.bs-name {
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.bs-provider {
  margin: 0 0 10rpx;
}

.booking-meta-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.booking-meta {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 23rpx;
  line-height: 1.4;
}

.booking-flow-card {
  border-left: 6rpx solid #8A6A2F;
}

.note-template-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.note-template {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #F7F2E8;
  color: #6B5734;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.4;
}

.booking-confirm-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.booking-confirm-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3E2F;
  margin-bottom: 14rpx;
}

.booking-confirm-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
}

.booking-confirm-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2D3E2F;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.booking-confirm-text {
  flex: 1;
  color: #6B7D6E;
  font-size: 25rpx;
  line-height: 1.65;
}
