/* ── 关于联结宇宙 弹窗 ── */

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-box {
  background: #FAFAF8;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-scroll {
  flex: 1;
  padding: 40rpx 36rpx 20rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.modal-close {
  padding: 24rpx 36rpx 40rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #2D3E2F;
  background: #FAFAF8;
  border-top: 1rpx solid #EAEAE5;
  flex: 0 0 auto;
}

/* 弹窗内容排版 */

.about-section {
  margin-bottom: 36rpx;
}

.about-heading {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3E2F;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.about-body {
  display: block;
  font-size: 26rpx;
  color: #6B7D6E;
  line-height: 1.7;
  margin-bottom: 12rpx;
}

/* 四步流程 */

.about-step {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.about-step-num {
  font-size: 28rpx;
  color: #2D3E2F;
  flex: 0 0 36rpx;
  line-height: 1.6;
}

.about-step-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #2D3E2F;
  line-height: 1.6;
}

.about-step-desc {
  display: block;
  font-size: 24rpx;
  color: #6B7D6E;
  line-height: 1.6;
  margin-top: 4rpx;
}

/* 场景表 */

.about-table {
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
}

.about-row {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #F0F0EC;
}

.about-row:last-child {
  border-bottom: none;
}

.about-row-scene {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #2D3E2F;
  margin-bottom: 4rpx;
}

.about-row-do {
  display: block;
  font-size: 24rpx;
  color: #6B7D6E;
  line-height: 1.5;
}

/* 概念速查 */

.about-glossary {
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
}

.about-term {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #F0F0EC;
}

.about-term:last-child {
  border-bottom: none;
}

.about-term-word {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #2D3E2F;
  margin-bottom: 4rpx;
}

.about-term-def {
  display: block;
  font-size: 24rpx;
  color: #6B7D6E;
  line-height: 1.5;
}

.about-footer {
  padding-bottom: 10rpx;
}
