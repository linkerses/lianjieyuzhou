/* ── 联结宇宙 · 全局样式 V0.2 ── */
/* 调性：温暖、干净、自然——对应联结者的品牌调性 */

/* 颜色系统 */
:root {
  --bg: #FAFAF8;
  --card-bg: #FFFFFF;
  --text-primary: #2D3E2F;
  --text-secondary: #6B7D6E;
  --text-muted: #A8B5A9;
  --accent: #2D3E2F;
  --accent-light: #E8EDE6;
  --border: #EAEAE5;
  --success: #4A7C59;
  --warning: #B8860B;
  --danger: #B84A4A;
}

page {
  background-color: #FAFAF8;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #2D3E2F;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ── 通用布局 ── */

.page {
  padding: 30rpx;
  padding-bottom: 156rpx;
  min-height: 100vh;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.card-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3E2F;
  line-height: 1.35;
}

.card-action {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #6B7D6E;
  line-height: 1.5;
  text-align: right;
}

.card-desc {
  font-size: 26rpx;
  color: #A8B5A9;
  margin-bottom: 20rpx;
  display: block;
  line-height: 1.6;
}

/* ── 标签 ── */

.tag {
  display: inline-block;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag-empty {
  color: #A8B5A9;
  font-size: 26rpx;
}

/* ── 信息行 ── */

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0EC;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #6B7D6E;
  font-size: 26rpx;
  flex-shrink: 0;
  line-height: 1.55;
}

.info-value {
  color: #2D3E2F;
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
  min-width: 0;
  line-height: 1.55;
  text-align: right;
  word-break: break-all;
}

.price {
  color: #B8860B;
  font-weight: 600;
}

.desc-block {
  margin-top: 20rpx;
}

.desc-label {
  font-size: 26rpx;
  color: #6B7D6E;
  display: block;
  margin-bottom: 10rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #2D3E2F;
  line-height: 1.7;
}

.service-desc-section {
  padding: 20rpx 0;
  border-top: 1rpx solid #F0F0EC;
}

.service-desc-section:first-child {
  border-top: none;
  padding-top: 0;
}

/* ── Tab切换 ── */

.tabs {
  display: flex;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid #EAEAE5;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.tab {
  flex-shrink: 0;
  padding: 16rpx 30rpx;
  font-size: 28rpx;
  color: #6B7D6E;
  position: relative;
  line-height: 1.45;
}

.tab.active {
  color: #2D3E2F;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 30rpx;
  right: 30rpx;
  height: 4rpx;
  background: #2D3E2F;
  border-radius: 2rpx;
}

/* ── 加载状态 ── */

.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #A8B5A9;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #A8B5A9;
  font-size: 28rpx;
  line-height: 1.7;
}

.empty .btn-inline {
  width: 320rpx;
  margin: 24rpx auto 0;
}

/* ── 按钮 ── */

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FAFAF8;
  border-top: 1rpx solid #EAEAE5;
  z-index: 100;
}

button::after {
  border: none;
}

button {
  box-sizing: border-box;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: normal;
  background: #2D3E2F;
  color: #FFFFFF;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.btn-primary:active {
  background: #1A2B1C;
}

.btn-primary[disabled] {
  background: #C4CDC0;
  color: #FFFFFF;
  opacity: 0.82;
}

.btn-inline {
  height: 64rpx;
  line-height: normal;
  background: #2D3E2F;
  color: #FFFFFF;
  border-radius: 32rpx;
  font-size: 26rpx;
  border: none;
  margin: 18rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.btn-muted {
  background: #E8EDE6;
  color: #2D3E2F;
}

/* ── 首页 ── */

.agent-banner {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.agent-info {
  display: flex;
  align-items: center;
}

.agent-avatar {
  width: 72rpx;
  height: 72rpx;
  background: #2D3E2F;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.agent-meta {
  flex: 1;
  min-width: 0;
}

.agent-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3E2F;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-tags {
  margin-top: 6rpx;
  display: flex;
  flex-wrap: wrap;
}

.trust-badge {
  flex-shrink: 0;
  background: #E8EDE6;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #2D3E2F;
  line-height: 1.35;
}

.community-feed-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 26rpx 0 26rpx 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.community-feed-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-right: 26rpx;
  margin-bottom: 18rpx;
}

.community-feed-title {
  display: block;
  font-size: 33rpx;
  font-weight: 800;
  color: #2D3E2F;
  line-height: 1.35;
}

.community-feed-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6B7D6E;
  line-height: 1.5;
}

.community-feed-more {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.community-feed-scroll {
  width: 100%;
  white-space: nowrap;
}

.community-feed-track {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 26rpx;
}

.community-feed-item {
  width: 470rpx;
  min-height: 190rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #FAFAF8;
  border-left: 6rpx solid #2D3E2F;
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  white-space: normal;
}

.community-feed-item.announcement {
  border-left-color: #8A6A2F;
  background: #F7F2E8;
}

.community-feed-item.demand {
  border-left-color: #8A6A2F;
}

.community-feed-item.service {
  border-left-color: #2D3E2F;
}

.community-feed-item.agent {
  border-left-color: #4A7C59;
}

.community-feed-type {
  display: block;
  color: #8A6A2F;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.community-feed-item-title {
  display: -webkit-box;
  color: #2D3E2F;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.community-feed-item-desc {
  display: -webkit-box;
  margin-top: 8rpx;
  color: #6B7D6E;
  font-size: 24rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.community-feed-action {
  display: block;
  margin-top: 16rpx;
  color: #2D3E2F;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}

/* Agent提醒卡片 */
.home-focus-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #2D3E2F;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.home-focus-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.home-focus-eyebrow {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #8A6A2F;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.home-focus-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2D3E2F;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.home-focus-desc {
  display: block;
  font-size: 26rpx;
  color: #6B7D6E;
  line-height: 1.65;
}

.home-focus-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0F0EC;
}

.home-focus-progress {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #A8B5A9;
  line-height: 1.4;
}

.home-focus-action {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3E2F;
  line-height: 1.4;
}

.note-compact {
  border-left-color: #8A6A2F;
}

.note-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #2D3E2F;
}

.note-header {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.note-icon { font-size: 28rpx; flex-shrink: 0; line-height: 1.4; }
.note-title { font-size: 28rpx; font-weight: 600; flex: 1; min-width: 0; line-height: 1.45; }
.note-dismiss { color: #A8B5A9; font-size: 32rpx; padding: 0 4rpx 0 10rpx; line-height: 1.2; }

.note-body {
  font-size: 28rpx;
  color: #6B7D6E;
  line-height: 1.6;
}

.note-suggestions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.suggestion-btn {
  background: #E8EDE6;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #2D3E2F;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 新用户引导 */
.onboarding {
  background: #E8EDE6;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.onboarding-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 10rpx; }
.onboarding-desc { font-size: 26rpx; color: #6B7D6E; display: block; margin-bottom: 16rpx; }
.onboarding-progress {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #2D3E2F;
  font-size: 24rpx;
  margin-bottom: 18rpx;
}
.onboarding-missing { color: #8A6A2F; }
.onboarding-btn { display: block; font-size: 28rpx; color: #2D3E2F; font-weight: 500; text-align: center; }

/* 新手任务 */
.starter-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.starter-header {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.starter-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3E2F;
}

.starter-desc {
  display: block;
  font-size: 24rpx;
  color: #6B7D6E;
  line-height: 1.5;
  margin-top: 6rpx;
}

.starter-count {
  min-width: 72rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #2D3E2F;
  background: #E8EDE6;
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
}

.starter-task {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #F0F0EC;
}

.starter-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #A8B5A9;
  color: #FFFFFF;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex: 0 0 36rpx;
}

.starter-task.done .starter-check {
  border-color: #4A7C59;
  background: #4A7C59;
}

.starter-main {
  flex: 1;
  min-width: 0;
}

.starter-task-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3E2F;
}

.starter-task-desc {
  display: block;
  font-size: 23rpx;
  color: #6B7D6E;
  line-height: 1.45;
  margin-top: 4rpx;
}

.starter-action {
  font-size: 24rpx;
  color: #B8860B;
  flex: 0 0 auto;
  line-height: 1.45;
  max-width: 132rpx;
  text-align: right;
}

.starter-task.done .starter-action {
  color: #4A7C59;
}

.discovery-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.discovery-head {
  margin-bottom: 18rpx;
}

.discovery-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3E2F;
}

.discovery-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7D6E;
  line-height: 1.6;
}

.discovery-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.home-action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.discovery-item {
  min-height: 132rpx;
  border-radius: 14rpx;
  padding: 18rpx 12rpx;
  background: #FAFAF8;
  border: 1rpx solid #EEEAE1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.discovery-item-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3E2F;
}

.discovery-item-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #6B7D6E;
  line-height: 1.38;
}

.home-action-grid .discovery-item-title,
.home-action-grid .discovery-item-desc {
  text-align: center;
}

.home-market-block {
  margin-bottom: 24rpx;
}

.home-market-block:last-child {
  margin-bottom: 0;
}

.home-market-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.home-market-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #2D3E2F;
}

.home-demand-card {
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 22rpx;
  margin-bottom: 12rpx;
  border-left: 5rpx solid #8A6A2F;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.home-demand-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #2D3E2F;
  line-height: 1.4;
}

.home-demand-desc {
  display: -webkit-box;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #6B7D6E;
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.home-demand-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #A8B5A9;
}

.service-card.compact {
  padding: 22rpx;
}

.service-card.compact .service-name {
  font-size: 29rpx;
}

.home-agent-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.home-agent-avatar {
  width: 68rpx;
  height: 68rpx;
  margin-right: 0;
  font-size: 28rpx;
}

.home-agent-main {
  flex: 1;
  min-width: 0;
}

.home-agent-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3E2F;
  line-height: 1.35;
}

.home-agent-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6B7D6E;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Section ── */

.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3E2F;
}

.section-more {
  font-size: 26rpx;
  color: #6B7D6E;
}

/* 推荐卡片 */
.recommend-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.rec-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.rec-emoji { font-size: 28rpx; margin-right: 8rpx; }
.rec-system { font-size: 22rpx; color: #6B7D6E; flex: 1; }
.rec-score { font-size: 24rpx; color: #2D3E2F; font-weight: 600; }

.rec-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3E2F;
  display: block;
  margin-bottom: 8rpx;
}

.rec-summary {
  font-size: 26rpx;
  color: #6B7D6E;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.rec-footer {
  display: flex;
  gap: 20rpx;
}

.rec-price {
  font-size: 28rpx;
  color: #B8860B;
  font-weight: 600;
}

.rec-duration {
  font-size: 26rpx;
  color: #A8B5A9;
}

.rec-risks {
  margin-top: 12rpx;
}

.risk-tag {
  display: inline-block;
  background: #FFF5E6;
  color: #B8860B;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-right: 8rpx;
  margin-top: 6rpx;
}

