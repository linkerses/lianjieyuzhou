/* ── 联结宇宙 · 全局样式 V0.2 ── */
/* 调性：温暖、干净、自然——对应联结者的品牌调性 */

/* 颜色系统 */
:root {
  --bg: #FAFAF8;
  --card-bg: #FFFFFF;
  --text-primary: #2D3E2F;
  --text-secondary: #6B7D6E;
  --text-muted: #A8B5A9;
  --accent: #2D3E2F;
  --accent-light: #E8EDE6;
  --border: #EAEAE5;
  --success: #4A7C59;
  --warning: #B8860B;
  --danger: #B84A4A;
}

page {
  background-color: #FAFAF8;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #2D3E2F;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ── 通用布局 ── */

.page {
  padding: 30rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3E2F;
}

.card-action {
  font-size: 26rpx;
  color: #6B7D6E;
}

.card-desc {
  font-size: 26rpx;
  color: #A8B5A9;
  margin-bottom: 20rpx;
  display: block;
}

/* ── 标签 ── */

.tag {
  display: inline-block;
  background: #E8EDE6;
  color: #2D3E2F;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag-empty {
  color: #A8B5A9;
  font-size: 26rpx;
}

/* ── 信息行 ── */

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0EC;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #6B7D6E;
  font-size: 26rpx;
}

.info-value {
  color: #2D3E2F;
  font-size: 28rpx;
  font-weight: 500;
}

.price {
  color: #B8860B;
  font-weight: 600;
}

.desc-block {
  margin-top: 20rpx;
}

.desc-label {
  font-size: 26rpx;
  color: #6B7D6E;
  display: block;
  margin-bottom: 10rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #2D3E2F;
  line-height: 1.7;
}

/* ── Tab切换 ── */

.tabs {
  display: flex;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid #EAEAE5;
}

.tab {
  padding: 16rpx 30rpx;
  font-size: 28rpx;
  color: #6B7D6E;
  position: relative;
}

.tab.active {
  color: #2D3E2F;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 30rpx;
  right: 30rpx;
  height: 4rpx;
  background: #2D3E2F;
  border-radius: 2rpx;
}

/* ── 加载状态 ── */

.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #A8B5A9;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #A8B5A9;
  font-size: 28rpx;
}

/* ── 按钮 ── */

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #FAFAF8;
  border-top: 1rpx solid #EAEAE5;
  z-index: 100;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #2D3E2F;
  color: #FFFFFF;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
  text-align: center;
  font-weight: 500;
}

.btn-primary:active {
  background: #1A2B1C;
}

.btn-primary[disabled] {
  background: #C4CDC0;
}

.btn-inline {
  height: 64rpx;
  line-height: 64rpx;
  background: #2D3E2F;
  color: #FFFFFF;
  border-radius: 32rpx;
  font-size: 26rpx;
  border: none;
  margin: 18rpx 0 0;
}

.btn-muted {
  background: #E8EDE6;
  color: #2D3E2F;
}

/* ── 首页 ── */

.agent-banner {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.agent-info {
  display: flex;
  align-items: center;
}

.agent-avatar {
  width: 72rpx;
  height: 72rpx;
  background: #2D3E2F;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.agent-meta {
  flex: 1;
}

.agent-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3E2F;
}

.agent-tags {
  margin-top: 6rpx;
}

.trust-badge {
  background: #E8EDE6;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #2D3E2F;
}

/* Agent提醒卡片 */
.note-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #2D3E2F;
}

.note-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.note-icon { font-size: 28rpx; margin-right: 10rpx; }
.note-title { font-size: 28rpx; font-weight: 600; flex: 1; }
.note-dismiss { color: #A8B5A9; font-size: 32rpx; padding: 0 10rpx; }

.note-body {
  font-size: 28rpx;
  color: #6B7D6E;
  line-height: 1.6;
}

.note-suggestions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.suggestion-btn {
  background: #E8EDE6;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #2D3E2F;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 新用户引导 */
.onboarding {
  background: #E8EDE6;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.onboarding-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 10rpx; }
.onboarding-desc { font-size: 26rpx; color: #6B7D6E; display: block; margin-bottom: 16rpx; }
.onboarding-btn { font-size: 28rpx; color: #2D3E2F; font-weight: 500; }

/* ── Section ── */

.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3E2F;
}

.section-more {
  font-size: 26rpx;
  color: #6B7D6E;
}

/* 推荐卡片 */
.recommend-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.rec-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.rec-emoji { font-size: 28rpx; margin-right: 8rpx; }
.rec-system { font-size: 22rpx; color: #6B7D6E; flex: 1; }
.rec-score { font-size: 24rpx; color: #2D3E2F; font-weight: 600; }

.rec-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3E2F;
  display: block;
  margin-bottom: 8rpx;
}

.rec-summary {
  font-size: 26rpx;
  color: #6B7D6E;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.rec-footer {
  display: flex;
  gap: 20rpx;
}

.rec-price {
  font-size: 28rpx;
  color: #B8860B;
  font-weight: 600;
}

.rec-duration {
  font-size: 26rpx;
  color: #A8B5A9;
}

.rec-risks {
  margin-top: 12rpx;
}

.risk-tag {
  display: inline-block;
  background: #FFF5E6;
  color: #B8860B;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-right: 8rpx;
  margin-top: 6rpx;
}

/* ── 交易 ── */

.tx-item, .tx-card {
  background: #FFFFFF;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.tx-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tx-service { font-size: 28rpx; font-weight: 500; }
.tx-meta { display: flex; gap: 20rpx; margin-top: 8rpx; }
.tx-system { font-size: 24rpx; color: #6B7D6E; }
.tx-amount { font-size: 26rpx; color: #B8860B; font-weight: 600; }
.tx-score { font-size: 24rpx; color: #4A7C59; margin-top: 8rpx; display: block; }

.tx-status { font-size: 24rpx; padding: 4rpx 14rpx; border-radius: 12rpx; }
.tx-pending { background: #F5F5F0; color: #6B7D6E; }
.tx-confirmed { background: #E8EDE6; color: #2D3E2F; }
.tx-completed { background: #FFF5E6; color: #B8860B; }
.tx-rated { background: #E8EDE6; color: #4A7C59; }
.tx-cancelled { background: #F5F5F0; color: #A8B5A9; }
.tx-active { background: #E8EDE6; color: #4A7C59; }
.tx-paused { background: #FFF5E6; color: #B8860B; }
.tx-archived { background: #F5F5F0; color: #A8B5A9; }

/* ── 服务列表 ── */

.filter-bar {
  display: flex;
  margin-bottom: 24rpx;
  white-space: nowrap;
  padding-bottom: 10rpx;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #6B7D6E;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}

.filter-item.active {
  background: #2D3E2F;
  color: #FFFFFF;
}

.service-card {
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.service-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.service-system { font-size: 22rpx; color: #6B7D6E; }
.service-price { font-size: 28rpx; color: #B8860B; font-weight: 600; }

.service-name { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 6rpx; }
.service-provider { font-size: 26rpx; color: #6B7D6E; display: block; margin-bottom: 12rpx; }

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 10rpx 0 12rpx;
}

.service-tag {
  display: inline-block;
  max-width: 240rpx;
  padding: 5rpx 14rpx;
  background: #F5F5F0;
  color: #6B7D6E;
  border-radius: 18rpx;
  font-size: 22rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-meta {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: #A8B5A9;
}

/* ── 服务详情 ── */

.pre-score-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #2D3E2F;
}

.pre-score-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.pre-score-label { font-size: 26rpx; color: #6B7D6E; }
.pre-score-value { font-size: 40rpx; font-weight: 700; }
.pre-score-unit { font-size: 24rpx; font-weight: 400; }

.pre-score-summary {
  font-size: 26rpx;
  color: #6B7D6E;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.pre-dimensions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.dim-item {
  background: #F5F5F0;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dim-label { font-size: 22rpx; color: #A8B5A9; }
.dim-score { font-size: 28rpx; font-weight: 600; color: #2D3E2F; }

.pre-risks {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0EC;
}

.risk-title { font-size: 24rpx; color: #B8860B; font-weight: 500; display: block; margin-bottom: 8rpx; }
.risk-item { font-size: 24rpx; color: #B8860B; display: block; margin-bottom: 4rpx; }

/* ── 预约 ── */

.booking-summary {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.bs-name { font-size: 36rpx; font-weight: 600; display: block; }
.bs-provider { font-size: 26rpx; color: #6B7D6E; display: block; margin: 8rpx 0; }
.bs-price { font-size: 32rpx; color: #B8860B; font-weight: 700; display: block; }

/* ── 表单 ── */

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6B7D6E;
  display: block;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #F5F5F0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2D3E2F;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #F5F5F0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #2D3E2F;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-textarea-large {
  min-height: 260rpx;
}

.form-help {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #A8B5A9;
}

.picker {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: #F5F5F0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2D3E2F;
  box-sizing: border-box;
}

/* ── 交易详情 ── */

.status-banner {
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.status-pending { background: #F5F5F0; color: #6B7D6E; }
.status-confirmed { background: #E8EDE6; color: #2D3E2F; }
.status-completed { background: #FFF5E6; color: #B8860B; }
.status-rated { background: #E8EDE6; color: #4A7C59; }
.status-cancelled { background: #F5F5F0; color: #A8B5A9; }

.feedback-text {
  font-size: 28rpx;
  color: #6B7D6E;
  line-height: 1.7;
}

/* ── 评分 ── */

.score-form {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #F5F5F0;
  border-radius: 12rpx;
}

/* ── 我的页面 ── */

.user-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  background: #2D3E2F;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-info { flex: 1; }
.user-name { font-size: 34rpx; font-weight: 700; display: block; }
.user-cid { font-size: 24rpx; color: #A8B5A9; display: block; margin: 6rpx 0; }
.user-hint { font-size: 26rpx; color: #B8860B; display: block; }

.trust-summary {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.trust-label { font-size: 26rpx; color: #6B7D6E; flex: 1; }
.trust-value { font-size: 40rpx; font-weight: 700; color: #2D3E2F; margin-right: 20rpx; }
.trust-detail { font-size: 24rpx; color: #A8B5A9; }

.menu-group {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #F0F0EC;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon { font-size: 32rpx; margin-right: 20rpx; }
.menu-label { flex: 1; font-size: 30rpx; }
.menu-arrow { font-size: 36rpx; color: #A8B5A9; }

.version {
  text-align: center;
  padding: 40rpx;
  color: #C4CDC0;
  font-size: 24rpx;
}

/* ── 服务方工作台 ── */

.seller-hero {
  padding: 8rpx 0 28rpx;
}

.seller-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2D3E2F;
}

.seller-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B7D6E;
  line-height: 1.6;
}

.stats-grid {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3E2F;
}

.stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6B7D6E;
}

.seller-section {
  margin-bottom: 28rpx;
}

.seller-toolbar {
  margin-bottom: 20rpx;
}

.service-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.service-actions .btn-inline {
  flex: 1;
  min-width: 160rpx;
}

.seller-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3E2F;
  margin-bottom: 14rpx;
}

.seller-order-card {
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.seller-order-meta {
  display: flex;
  gap: 18rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6B7D6E;
}

/* ── 技能系统 ── */

.skill-list {
  margin-top: 10rpx;
}

.skill-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0EC;
}

.skill-item:last-child { border-bottom: none; }

.skill-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.skill-name { font-size: 30rpx; font-weight: 600; }

.skill-desc {
  font-size: 26rpx;
  color: #6B7D6E;
  display: block;
  margin-bottom: 10rpx;
}

.skill-levels {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.level-tag {
  font-size: 22rpx;
  color: #A8B5A9;
  background: #F5F5F0;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.skill-recommend {
  font-size: 22rpx;
  color: #4A7C59;
  display: block;
  margin-top: 8rpx;
}

/* ── 标签编辑 ── */

.tag-display {
  display: flex;
  flex-wrap: wrap;
}

.profile-section {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F0EC;
}

.profile-section:last-child {
  border-bottom: none;
}

.profile-label {
  display: block;
  font-size: 26rpx;
  color: #6B7D6E;
  margin-bottom: 8rpx;
}

.profile-text {
  display: block;
  font-size: 28rpx;
  color: #2D3E2F;
  line-height: 1.7;
  white-space: pre-wrap;
}

.profile-empty {
  display: block;
  font-size: 26rpx;
  color: #A8B5A9;
  line-height: 1.6;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-option {
  padding: 12rpx 24rpx;
  background: #F5F5F0;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #6B7D6E;
}

.tag-option.selected {
  background: #2D3E2F;
  color: #FFFFFF;
}

.editor-hint {
  font-size: 24rpx;
  color: #A8B5A9;
  display: block;
  margin-bottom: 16rpx;
}

.editor-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn-cancel {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #F5F5F0;
  color: #6B7D6E;
  border-radius: 36rpx;
  text-align: center;
  font-size: 28rpx;
}

.btn-save {
  flex: 2;
  height: 72rpx;
  line-height: 72rpx;
  background: #2D3E2F;
  color: #FFFFFF;
  border-radius: 36rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}
